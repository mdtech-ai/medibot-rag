# Copier ce fichier en .env puis renseigner les valeurs
GOOGLE_API_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=

# Un index Pinecone par modèle d'embedding (les vecteurs de deux modèles ne sont pas comparables)
PINECONE_INDEX_NAME=medibot-e5-ctx

# Modèle d'embedding : "local" (multilingual-e5-base, gratuit, sans quota) ou "gemini" (API Google)
EMBEDDING_PROVIDER=local

# Observabilité Langfuse (facultatif : sans ces clés, le traçage est désactivé)
# Région UE : https://cloud.langfuse.com ; auto-hébergé : http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Reranker (cross-encoder local) : reclasse les passages récupérés ; "none" pour le désactiver
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Nombre de passages reclassés par le reranker (compromis qualité/latence : 20 = meilleure qualité, 10 = plus rapide)
RERANKER_FETCH_K=20
